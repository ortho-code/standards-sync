#!/usr/bin/env php
<?php

declare(strict_types=1);

use StandardsSync\Presentation\Cli\Application;

// Composer's bin proxy sets $_composer_autoload_path to the invoking project's autoloader; prefer it so a symlinked install still loads the consumer's classes.
// Fall back to the layouts this bin can run from: installed as a dependency, a standalone checkout, then the invoking project.
$autoloadCandidates = array_filter([
    $_composer_autoload_path ?? null,
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../../../../vendor/autoload.php',
    __DIR__ . '/../vendor/autoload.php',
    getcwd() . '/vendor/autoload.php',
]);

$autoloadFile = null;
foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        $autoloadFile = $candidate;
        break;
    }
}

if ($autoloadFile === null) {
    fwrite(STDERR, 'Could not find the Composer autoloader. Run "composer install".' . PHP_EOL);
    exit(1);
}

require_once $autoloadFile;

exit((new Application())->run());
