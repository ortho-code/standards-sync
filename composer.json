{
  "name": "ortho-code/standards-sync",
  "description": "Keeps shared config files in sync across repositories",
  "type": "library",
  "keywords": ["coding-standards", "code-quality", "config-sync", "drift-detection", "standards", "sync"],
  "license": "MIT",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-dom": "*",
    "ext-iconv": "*",
    "composer-runtime-api": "^2.1",
    "composer/semver": "^3.4",
    "symfony/console": "^8.1",
    "symfony/filesystem": "^8.1"
  },
  "require-dev": {
    "ortho-code/coding-standards": "^0.3",
    "colinodell/json5": "^3.0",
    "deptrac/deptrac": "^4",
    "nette/neon": "^3.4",
    "phpunit/phpunit": "^12",
    "rector/rector": "^2.5",
    "symfony/yaml": "^8.1",
    "symplify/easy-coding-standard": "^13.3",
    "vimeo/psalm": "^6.14",
    "phpstan/phpstan": "^2.2",
    "roave/security-advisories": "dev-latest"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "OrthoCode\\StandardsSync\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\OrthoCode\\StandardsSync\\": "tests/"
    },
    "exclude-from-classmap": [
      "tests/**/fixtures/"
    ]
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"file_exists('vendor/bin/standards-sync') or symlink('../../bin/standards-sync', 'vendor/bin/standards-sync');\""
    ],
    "post-update-cmd": [
      "@php -r \"file_exists('vendor/bin/standards-sync') or symlink('../../bin/standards-sync', 'vendor/bin/standards-sync');\""
    ],
    "app-run-tests": [
      "phpunit"
    ],
    "app-run-tests-unit": [
      "vendor/bin/phpunit --testsuite unit"
    ],
    "app-run-tests-integration": [
      "vendor/bin/phpunit --testsuite integration"
    ],
    "app-run-tests-scenario": [
      "vendor/bin/phpunit --testsuite scenario"
    ],
    "app-generate-rule-catalog": [
      "@php bin/generate-rule-catalog"
    ],
    "deptrac": [
      "vendor/bin/deptrac --no-cache --fail-on-uncovered"
    ],
    "app-ecs": [
      "ecs check"
    ],
    "app-ecs-fix": [
      "ecs check --fix"
    ],
    "app-rector": [
      "rector process --dry-run"
    ],
    "app-rector-fix": [
      "rector process"
    ],
    "app-phpstan": [
      "phpstan analyse"
    ],
    "app-psalm": [
      "psalm"
    ],
    "app-sync": [
      "standards-sync sync"
    ],
    "app-sync-check": [
      "standards-sync sync --check"
    ],
    "app-checks": [
      "@app-sync-check",
      "@app-ecs",
      "@app-phpstan",
      "@app-psalm",
      "@app-rector",
      "@app-run-tests"
    ]
  },
  "bin" : [
    "bin/standards-sync"
  ],
  "extra": {
    "branch-alias": {
      "dev-main": "0.3.x-dev"
    }
  }
}
